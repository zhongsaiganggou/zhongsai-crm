NODE_ENV=development
PORT=3000
DATABASE_URL=postgresql://zhongsai:change_me@localhost:5432/zhongsai_crm?schema=public
JWT_ACCESS_SECRET=replace_with_at_least_32_random_characters
JWT_REFRESH_SECRET=replace_with_another_32_random_characters
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL_DAYS=30
CORS_ORIGINS=http://localhost:5173

# Meta Lead Ads
META_VERIFY_TOKEN=replace_with_meta_webhook_verify_token
META_APP_SECRET=replace_with_meta_app_secret
META_PAGE_ACCESS_TOKEN=
META_GRAPH_API_VERSION=v25.0
META_GRAPH_BASE_URL=https://graph.facebook.com

# 首次启动的管理员账号，仅供 seed 使用
SEED_ADMIN_MOBILE=13800000000
SEED_ADMIN_PASSWORD=ChangeMe123!

# 企业微信群机器人 Webhook（用于新线索通知、跟进提醒、公海回收通知）
WECHAT_WEBHOOK_URL=https://qyapi.weixin.qq.com/cgi-bin/webhook/send?key=your_key_here

# CRM 公网访问地址（用于网站表单对接）
CRM_PUBLIC_URL=https://crm.yourdomain.com
